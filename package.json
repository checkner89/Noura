{
  "name": "noura-health-tracker",
  "version": "0.12.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor@latest",
    "typecheck": "tsc --noEmit",
    "eas:init": "npx eas-cli@latest init",
    "eas:login": "npx eas-cli@latest login",
    "ios:register": "npx eas-cli@latest device:create",
    "ios:build:install": "npx eas-cli@latest build --platform ios --profile preview",
    "ios:build:store": "npx eas-cli@latest build --platform ios --profile production",
    "ios:install:register": "npx eas-cli@latest device:create",
    "ios:install:build": "npx eas-cli@latest build --platform ios --profile preview",
    "ios:free:info": "echo See INSTALL_FREE_IOS_WINDOWS.md for the free Apple Account sideload flow."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.17",
    "expo-secure-store": "^57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-camera": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-background-task": "~57.0.16",
    "expo-task-manager": "~57.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
